# Defaults are mock/mock -> runs with no credentials.
USE_CASE=dq_qals            # dq_qals | parity_hana_snowflake

# --- WORKER model (generates + refines) ---
WORKER_PROVIDER=mock           # mock | anthropic | cortex | databricks     (auto = mock)
WORKER_MODEL=auto              # auto = that provider's default model; or pin one, e.g. claude-sonnet-4-5
SQL_TOOL=mock               # mock | cortex | genie

# --- EVALUATOR model (scores the rubric); chosen INDEPENDENTLY of the worker ---
# Symmetric to the worker knobs; both default to the worker, so leave as auto to keep
# evaluator == worker. Set them to judge with a different / stronger model
# (a model shouldn't grade its own output). Works same-provider OR cross-provider.
# EVAL_PROVIDER=auto     # auto = same provider as the worker; or a different provider
# EVAL_MODEL=auto            # auto = that provider's default; or pin a different model
#
# Model precedence per role:  WORKER_MODEL / EVAL_MODEL  >  <PROVIDER>_MODEL  >  built-in default

# anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# snowflake / cortex
# SNOWFLAKE_ACCOUNT=...  SNOWFLAKE_USER=...  SNOWFLAKE_PASSWORD=...
# SNOWFLAKE_WAREHOUSE=... SNOWFLAKE_ROLE=...
# CORTEX_SEMANTIC_MODEL=@db.schema.stage/model.yaml

# databricks
# DATABRICKS_HOST=https://xxx.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...
# GENIE_SPACE_ID=01ef...
