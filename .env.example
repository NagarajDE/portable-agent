# Defaults are mock/mock -> runs with no credentials.
USE_CASE=dq_qals            # dq_qals | parity_hana_snowflake

# --- WORKER model (generates + refines) ---
WORKER_PROVIDER=mock           # mock | anthropic | cortex | databricks     (auto = mock)
WORKER_MODEL=auto              # auto = that provider's default model; or pin one, e.g. claude-sonnet-4-5
LLM_MAX_TOKENS=4096            # output cap for anthropic/databricks; truncation raises (raise if outputs get long)
SQL_TOOL=mock               # mock | cortex | genie
SQL_TIMEOUT_SECONDS=30      # bound warehouse time for model-generated SQL (cortex)

# --- generic tool layer (packs that declare `tools:`; SQL is just one tool type) ---
# These apply to ANY tool a pack runs; they don't affect legacy single-SQL packs.
TOOL_TIMEOUT_SECONDS=30     # per-tool call timeout (dispatch backstop; >=1)
TOOL_MAX_CONCURRENCY=4      # bounded worker pool size for tool execution
HTTP_TOOL_MODE=mock         # generic http tool: mock (canned, no network) | http (real GET)
HTTP_TOOL_ALLOWLIST=        # comma-separated hosts the http tool may call, e.g. api.example.com
# A bearer token for the http tool (when used) comes from an env var NAMED by the pack's
# `token_env` param -- the token VALUE is read from env only, never written in a pack or logged.
CORTEX_ANALYST_TIMEOUT_SECONDS=60   # HTTP timeout for the Analyst text-to-SQL REST call (cortex)
SQL_MAX_ROWS=100            # rows the LLM SEES (aggregate in SQL for big data). BIGGEST TOKEN LEVER:
#   the result set is re-sent into generate + EVERY rubric + EVERY refine, so ~ (max_iters x2) times.
#   100 rows x ~200 chars can dominate input tokens/question -- lower it, or aggregate in the query.

# --- EVALUATOR model (scores the rubric); chosen INDEPENDENTLY of the worker ---
# Symmetric to the worker knobs; both default to the worker, so leave as auto to keep
# evaluator == worker. Set them to judge with a different / stronger model
# (a model shouldn't grade its own output). Works same-provider OR cross-provider.
# EVAL_PROVIDER=auto     # auto = same provider as the worker; or a different provider
# EVAL_MODEL=auto            # auto = that provider's default; or pin a different model
#
# Model precedence per role:  WORKER_MODEL / EVAL_MODEL  >  <PROVIDER>_MODEL  >  built-in default

# --- memory (episodic + feedback flywheel; append-only, you own it) ---
MEMORY_STORE=none           # none (default) | mock | sqlite | snowflake
# MEMORY_SQLITE_PATH=portable_agent_memory.db   # local file when MEMORY_STORE=sqlite

# --- observability (structured loop events: run_start/generate/evaluate/refine/run_end) ---
TRACER=stdout               # stdout (zero-dep JSON, default) | otel | mlflow | eventtable | none
TRACE_INCLUDE_CONTENT=false # true = include answer/verdict text in traces (opt-in; off = metrics only, for privacy)
# TRACER=otel needs the optional opentelemetry packages (see requirements.txt) and a backend:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318   # unset -> prints spans to the console
# OTEL_SERVICE_NAME=portable-agent

# anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# snowflake / cortex
# TO TEST CORTEX LOCALLY: set WORKER_PROVIDER=cortex and SQL_TOOL=cortex above, then fill in
# the values below and uncomment them. (Inside SPCS none of this is needed -- Snowflake
# injects an OAuth token + SNOWFLAKE_HOST automatically.)
# ONE secret -- a Programmatic Access Token (PAT) -- authenticates BOTH the Snowpark session
# (COMPLETE + running SQL) AND the Cortex Analyst REST call. No SNOWFLAKE_PASSWORD needed.
# SNOWFLAKE_ACCOUNT=...  SNOWFLAKE_USER=...
# SNOWFLAKE_PAT=<programmatic access token>          # used as the password AND the REST bearer
# SNOWFLAKE_HOST=<account>.snowflakecomputing.com   # required for the Cortex Analyst REST call
# SNOWFLAKE_WAREHOUSE=... SNOWFLAKE_ROLE=... SNOWFLAKE_DATABASE=... SNOWFLAKE_SCHEMA=...  # added if set
# SNOWFLAKE_SECONDARY_ROLES=all   # use ALL granted roles' privileges in the session (unset=leave as-is).
#   Handy when your primary role lacks a grant another role has (e.g. SNOWFLAKE.CORTEX_USER, without
#   which SNOWFLAKE.CORTEX.COMPLETE looks like an 'unknown function').
# SEMANTIC LAYER: an AI+BI/Analyst pack DECLARES its own view/model in
# usecases/<pack>/semantic_layer.yaml -- THAT is the source of truth, read by the engine.
# The two vars below are a TEST-ONLY OVERRIDE, read ONLY by the runner scripts (run_local.py /
# run_evals.py) to point a local run at a DIFFERENT layer than the pack declares (view wins if both):
# CORTEX_SEMANTIC_VIEW=MY_DB.MY_SCHEMA.MY_SEMANTIC_VIEW   # an EXISTING native Semantic View
# CORTEX_SEMANTIC_MODEL=@db.schema.stage/model.yaml       # or a semantic model YAML on a stage
# CORTEX_MODEL=claude-3-5-sonnet                     # optional: Cortex COMPLETE model

# databricks
# DATABRICKS_HOST=https://xxx.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...
# GENIE_SPACE_ID=01ef...
